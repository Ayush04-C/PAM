# PAM development configuration. Keep real values only in an ignored .env file.
PAM_ENVIRONMENT=development
PAM_APP_SECRET=replace-with-a-production-secret

# Use fake mode for offline development and automated tests.
PAM_CALENDAR_BACKEND=fake
# Required only when PAM_CALENDAR_BACKEND=google.
PAM_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
PAM_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
PAM_GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/oauth/google/callback
PAM_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
PAM_CREDENTIAL_STORAGE_PATH=.pam-google-credentials.bin

# Phase 6 local conversation mode. Use fake for offline development and tests.
PAM_MODEL_PROVIDER=fake
PAM_GEMINI_API_KEY=replace-with-a-gemini-api-key
PAM_GEMINI_MODEL=gemini-2.5-flash
PAM_CONVERSATION_DEBUG_TOOL_CALLS=false

# Phase 7 local Telegram polling. Keep the token and your numeric user ID private.
PAM_TELEGRAM_ENABLED=false
PAM_TELEGRAM_BOT_TOKEN=replace-with-a-telegram-bot-token
PAM_TELEGRAM_ALLOWED_USER_IDS=123456789
